<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Notes – All Notes</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="d-flex flex-column min-vh-100">

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold fs-4" href="/">
        <i class="bi bi-journal-text me-2"></i>My Notes
      </a>
      <a href="/notes/new" class="btn btn-light btn-sm ms-auto">
        <i class="bi bi-plus-circle me-1"></i>New Note
      </a>
    </div>
  </nav>

  <!-- Main -->
  <main class="container my-4 flex-grow-1">

    <h2 class="mb-4 fw-semibold">All Notes</h2>

    <!-- Search & Filter Form (Bonus) -->
    <form method="GET" action="/" class="row g-2 mb-4">
      <div class="col-md-5">
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-search"></i></span>
          <input
            type="text"
            name="search"
            class="form-control"
            placeholder="Search by title…"
            value="<%= search %>"
          />
        </div>
      </div>
      <div class="col-md-4">
        <select name="category" class="form-select">
          <option value="">All Categories</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat %>" <%= selectedCategory === cat ? 'selected' : '' %>>
              <%= cat %>
            </option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Filter</button>
      </div>
      <div class="col-md-1">
        <a href="/" class="btn btn-outline-secondary w-100" title="Clear filters">
          <i class="bi bi-x-circle"></i>
        </a>
      </div>
    </form>

    <!-- Notes Grid -->
    <% if (notes.length === 0) { %>
      <div class="text-center py-5">
        <i class="bi bi-journal-x display-4 text-muted"></i>
        <p class="mt-3 text-muted fs-5">No notes found. <a href="/notes/new">Add one!</a></p>
      </div>
    <% } else { %>
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        <% notes.forEach(note => { %>
          <div class="col">
            <div class="card h-100 shadow-sm note-card">
              <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <h5 class="card-title mb-0"><%= note.title %></h5>
                  <span class="badge bg-primary ms-2 text-nowrap"><%= note.category %></span>
                </div>
                <p class="card-text text-muted flex-grow-1"><%= note.content %></p>
                <small class="text-muted mt-2">
                  <i class="bi bi-calendar3 me-1"></i>
                  <%= new Date(note.createdAt).toLocaleString('en-IN', {
                        day: '2-digit', month: 'short', year: 'numeric',
                        hour: '2-digit', minute: '2-digit'
                      }) %>
                </small>
              </div>
              <div class="card-footer d-flex gap-2 bg-transparent border-top-0 pt-0">
                <!-- Edit Button (Bonus) -->
                <a href="/notes/<%= note._id %>/edit" class="btn btn-sm btn-outline-secondary flex-grow-1">
                  <i class="bi bi-pencil me-1"></i>Edit
                </a>
                <!-- Delete Button -->
                <form action="/notes/<%= note._id %>/delete" method="POST" class="flex-grow-1"
                      onsubmit="return confirm('Delete this note?')">
                  <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                    <i class="bi bi-trash me-1"></i>Delete
                  </button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

  </main>

  <!-- Footer -->
  <footer class="text-center text-muted py-3 border-top mt-auto">
    <small>My Notes &copy; <%= new Date().getFullYear() %></small>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
