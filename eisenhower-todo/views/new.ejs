<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Task - Eisenhower Todo</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>Add New Task</h1>
            <a href="/tasks" class="btn btn-secondary">Back to Matrix</a>
        </header>
        
        <form action="/tasks" method="POST" class="task-form">
            <div class="form-group">
                <label for="title">Title *</label>
                <input type="text" id="title" name="title" required placeholder="What needs to be done?">
            </div>
            
            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" rows="4" placeholder="Additional details..."></textarea>
            </div>
            
            <div class="form-group checkbox-group">
                <label>
                    <input type="checkbox" name="isUrgent"> Is Urgent
                </label>
            </div>
            
            <div class="form-group checkbox-group">
                <label>
                    <input type="checkbox" name="isImportant"> Is Important
                </label>
            </div>
            
            <button type="submit" class="btn btn-primary submit-btn">Save Task</button>
        </form>
    </div>
</body>
</html>
